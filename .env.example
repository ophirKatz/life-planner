# Client-side, safe to ship in the app bundle (Expo inlines EXPO_PUBLIC_* at build time).
# Never put anything here beyond publishable/anon keys — no secrets, no service-role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat public SDK keys (per-platform, safe to ship — see DESIGN.md §7).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth client ID for the native/PKCE flow (public by design for installed apps).
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Everything below is server-side ONLY: Supabase Edge Function secrets.
# Set these with `supabase secrets set --env-file .env.server` (a separate file
# you keep out of the client bundle entirely). They must NEVER be prefixed
# EXPO_PUBLIC_ and must NEVER be read by app code.
# ---------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# EXPO_ACCESS_TOKEN=
