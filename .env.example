# Client-side, safe to ship in the app bundle (Expo inlines EXPO_PUBLIC_* at build time).
# Never put anything here beyond publishable/anon keys — no secrets, no service-role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat public SDK keys (per-platform, safe to ship — see DESIGN.md §7).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth client ID for the native/PKCE flow (public "installed app" type —
# iOS or Android in Google Cloud Console, custom-scheme redirect, no secret).
# Used for both sign-in (M0) and the Calendar integration (M5).
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Everything below is server-side ONLY: Supabase Edge Function secrets.
# Set them with, e.g.:
#   supabase secrets set GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... \
#     TOKEN_ENCRYPTION_KEY=... REVENUECAT_WEBHOOK_SECRET=... EXPO_ACCESS_TOKEN=...
# They must NEVER be prefixed EXPO_PUBLIC_ and must NEVER be read by app code.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function — do not set them yourself.
# ---------------------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID=            # same value as EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET=        # only if you registered a confidential (Web) client instead
# TOKEN_ENCRYPTION_KEY=              # 32 random bytes, base64-encoded: `openssl rand -base64 32`
# REVENUECAT_WEBHOOK_SECRET=
# EXPO_ACCESS_TOKEN=

# One-time manual step (never put a real secret in a migration file — see
# supabase/migrations/0009_google_calendar_cron.sql): in the Supabase SQL
# editor, run:
#   select vault.create_secret('<your-service-role-key>', 'service_role_key');
# This lets the pg_cron job authenticate its call to sync-google-calendar.
